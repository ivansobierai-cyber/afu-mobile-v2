{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web:preview && npm run prepare:web-dist",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.afuagro.tech" }],
      "destination": "https://afuagro.tech/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.afuagro.tech" }],
      "destination": "https://afuagro.tech/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*\\.ttf)",
      "headers": [{ "key": "Content-Type", "value": "font/ttf" }]
    },
    {
      "source": "/assets/(.*\\.woff2)",
      "headers": [{ "key": "Content-Type", "value": "font/woff2" }]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.afuagro.tech" }],
      "destination": "https://afu-mobile-v2-production.up.railway.app/$1"
    },
    {
      "source": "/((?!_expo|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
