# Copie para .env e preencha os valores locais.
# Nunca commite o arquivo .env.

# MySQL / MariaDB (obrigatório para API e seed)
DATABASE_URL=mysql://afu:afu_local_dev@127.0.0.1:3306/afu_mobile

# JWT (obrigatório para login)
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Sem isso: anexos por URL funcionam; upload de arquivo fica desligado.
# Opção A — R2 / S3 (recomendado)
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# Opção B — Forge / LLM OpenAI-compatível (diagnóstico IA + presign legado)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_MODEL=qwen3-vl-plus
# Alibaba MaaS (*.maas.aliyuncs.com): use o host https://… (com ou sem /compatible-mode).
# O cliente LLM acrescenta /compatible-mode/v1/chat/completions automaticamente.
# `model` é obrigatório no MaaS; sem BUILT_IN_FORGE_MODEL o default é qwen3-vl-plus.

# Etapa 9 — treinamento/melhoria de modelos com dados privados (default: false)
# Só tem efeito se a organização também optar por aiAllowModelImprovement
# AI_ALLOW_TRAINING=false

# Identificador do app (opcional em dev local)
VITE_APP_ID=afu-mobile-local-dev

# API base para dispositivo físico / dev client (use o IP da sua máquina na LAN)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Alertas climáticos automáticos (push geada/chuva/calor/vento)
# WEATHER_ALERTS_ENABLED=1
# WEATHER_ALERTS_INTERVAL_MS=21600000
# SCHEDULED_TASK_SECRET=troque_por_segredo_longo

# Produção EAS — configure no dashboard Expo (Secrets) ou eas.json env
# Hostname canônico da API (health 200): https://api.afuagro.tech
# EXPO_PUBLIC_API_BASE_URL=https://api.afuagro.tech

# Login demo (legado / APK preview) — NÃO habilitar em produção web/loja (afuagro.tech)
# A tela de login não exibe mais botões de acesso rápido; a flag só afeta builds que a leem.
# Builds web (`build-web-preview`) e profile EAS `production` defaultam para 0.
# EXPO_PUBLIC_SHOW_DEMO_LOGIN=0
# EXPO_PUBLIC_DEV_SKIP_AUTH=0

# Opcional — OAuth Manus / e-mail
# OAUTH_SERVER_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
